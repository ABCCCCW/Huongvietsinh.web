@{
    ViewData["Title"] = "Tổ Chức Sự Kiện";
}

@section Styles {
    <link rel="stylesheet" href="~/css/services.css">
}

<!-- Banner -->
<section class="services-banner">
    <div class="banner-overlay"></div>
    <div class="container banner-content">
        <h1 class="animate-fade-in">Tổ Chức Sự Kiện & Liên Hoan</h1>
        <p class="animate-fade-in" style="animation-delay: 0.2s">Giải pháp hậu cần ẩm thực chuyên nghiệp cho doanh nghiệp</p>
    </div>
</section>

<!-- Breadcrumb -->
<div class="breadcrumb">
    <div class="container">
        <a asp-controller="Home" asp-action="Index">Trang chủ</a>
        <span>/</span>
        <a asp-controller="Services" asp-action="Index">Dịch vụ</a>
        <span>/</span>
        <strong>Tổ chức sự kiện, liên hoan</strong>
    </div>
</div>

<!-- Zone 1: Đội ngũ chuyên nghiệp -->
<section class="section team-section">
    <div class="container">
        <div class="team-grid">
            <div class="team-image animate-fade-in">
                <img src="~/image/no-image.png" data-original="hvs-nhan-vien-bep.jpg" alt="Đội ngũ đầu bếp chuyên nghiệp">
            </div>
            <div class="team-text animate-fade-in" style="animation-delay: 0.2s">
                <h2>Đội Ngũ Chuyên Nghiệp & Nguồn Gốc An Toàn</h2>
                <p>Mỗi sự kiện là một dấu ấn đáng nhớ, và chúng tôi hiểu rằng ẩm thực chính là linh hồn của những khoảnh khắc ấy.</p>
                <p>Đội ngũ đầu bếp tại Hương Việt Sinh không chỉ sở hữu kỹ năng điêu luyện từ các hội thi chuyên môn mà còn mang trong mình sự tận tâm của người làm nghề. Chúng tôi tự hào mang đến thực đơn phong phú được chế biến từ nguồn nguyên liệu an toàn, giúp thực khách không chỉ ngon miệng mà còn cảm thấy được che chở về sức khỏe trong suốt buổi tiệc.</p>
                <div class="highlight-box">
                    <p><i class="fas fa-shield-alt" style="color: var(--accent-color); margin-right: 8px;"></i> Nhanh - Sạch - Công suất lớn</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Zone 2: Loại hình dịch vụ -->
<section class="section event-types-section">
    <div class="container">
        <h2 class="section-title">Loại Hình Dịch Vụ Đa Dạng</h2>
        <p class="section-subtitle">Chúng tôi thiết kế các gói dịch vụ đa dạng để phù hợp với từng không gian và tính chất của sự kiện.</p>

        <div class="event-types-grid">
            <div class="event-type-card animate-fade-in">
                <div class="event-type-image">
                    <img src="~/image/no-image.png" data-original="hvs-bep-an-hoc-duong.jpg" alt="Tiệc buffet học đường">
                </div>
                <div class="event-type-content">
                    <h3><i class="fas fa-graduation-cap" style="color: var(--secondary-color); margin-right: 8px;"></i> Tiệc Buffet Học Đường</h3>
                    <p>Tạo không gian vui vẻ, hào hứng cho các con với những món ăn đầy màu sắc và dinh dưỡng. Thực đơn được thiết kế riêng cho từng sự kiện: lễ khai giảng, Tết Trung Thu, liên hoan cuối năm...</p>
                </div>
            </div>
            <div class="event-type-card animate-fade-in" style="animation-delay: 0.2s">
                <div class="event-type-image">
                    <img src="~/image/no-image.png" data-original="hvs-le-ky-ket-hop-tac.jpg" alt="Tiệc liên hoan doanh nghiệp">
                </div>
                <div class="event-type-content">
                    <h3><i class="fas fa-building" style="color: var(--secondary-color); margin-right: 8px;"></i> Tiệc Liên Hoan Doanh Nghiệp</h3>
                    <p>Gắn kết đội ngũ thông qua những bữa tiệc ấm cúng, sang trọng và chỉn chu trong từng chi tiết. Phù hợp cho các buổi Year-End Party, Team Building, kỷ niệm thành lập công ty...</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- CTA -->
<section class="cta-section">
    <div class="container">
        <h2>Lên Kế Hoạch Cho Sự Kiện Của Bạn</h2>
        <p>Hãy để Hương Việt Sinh đồng hành cùng bạn tạo nên những bữa tiệc hoàn hảo, an toàn và đáng nhớ.</p>
        <div class="cta-buttons">
            <a asp-controller="Contact" asp-action="Index" class="btn btn-primary">
                <i class="fas fa-paper-plane"></i> Gửi Yêu Cầu Báo Giá
            </a>
            <a href="tel:0963826668" class="btn btn-secondary">
                <i class="fas fa-phone-alt"></i> Gọi 0963.826.668
            </a>
        </div>
    </div>
</section>
