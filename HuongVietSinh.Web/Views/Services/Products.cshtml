@section Scripts {
<script>
document.addEventListener('DOMContentLoaded', function() {
    var grid = document.getElementById('productsGrid');
    if (!grid) return;

    var allCards = Array.from(grid.querySelectorAll('.product-card'));
    var prevBtn = document.querySelector('.products-arrow.prev');
    var nextBtn = document.querySelector('.products-arrow.next');
    var total = allCards.length;
    var startIdx = 0;
    var timer = null;

    function getColsAndVisible() {
        var w = window.innerWidth;
        if (w <= 480) return { cols: 2, visible: 2 };
        if (w <= 768) return { cols: 2, visible: 4 };
        return { cols: 3, visible: 6 };
    }

    function render() {
        var cfg = getColsAndVisible();
        grid.style.gridTemplateColumns = 'repeat(' + cfg.cols + ', 1fr)';

        for (var i = 0; i < total; i++) {
            var offset = (i - startIdx + total) % total;
            allCards[i].style.display = (offset < cfg.visible) ? '' : 'none';
        }
    }

    function goNext() {
        var cfg = getColsAndVisible();
        startIdx = (startIdx + cfg.visible) % total;
        render();
    }

    function goPrev() {
        var cfg = getColsAndVisible();
        startIdx = (startIdx - cfg.visible + total) % total;
        render();
    }

    function startAuto() {
        if (timer) clearInterval(timer);
        timer = setInterval(goNext, 7000);
    }

    if (prevBtn) {
        prevBtn.addEventListener('click', function() { goPrev(); startAuto(); });
    }
    if (nextBtn) {
        nextBtn.addEventListener('click', function() { goNext(); startAuto(); });
    }

    window.addEventListener('resize', render);

    allCards.forEach(function(card) {
        card.addEventListener('click', function() {
            if (window.innerWidth <= 992) card.classList.toggle('flipped');
        });
    });

    render();
    startAuto();
});
</script>
}
