@{
    ViewData["Title"] = "Hệ Sinh Thái";
}

@section Styles {
    <link rel="stylesheet" href="~/css/ecosystem-map.css" asp-append-version="true" />
}

<section class="ecosystem-wrapper">
    <div class="map-viewport" id="map-viewport">
        <div class="map-container" id="map-container">

            <!-- ===== SKY ===== -->
            <div class="sun"></div>
            <div class="cloud cloud-1" style="top: 25px; left: 80px;"><div class="cloud-body"></div></div>
            <div class="cloud cloud-2" style="top: 85px; left: 550px;"><div class="cloud-body"></div></div>
            <div class="cloud cloud-3" style="top: 15px; left: 1300px;"><div class="cloud-body"></div></div>
            <div class="cloud cloud-1" style="top: 95px; left: 2100px;"><div class="cloud-body"></div></div>
            <div class="cloud cloud-2" style="top: 40px; left: 2700px;"><div class="cloud-body"></div></div>

            <!-- ===== GROUND ===== -->
            <div class="ground"></div>

            <!-- ===== RIVER ===== -->
            <div class="river"></div>

            <!-- ===== ROADS ===== -->
            <div class="road road-h" style="bottom: 40%; left: 3%; width: 92%;"></div>
            <div class="road road-v" style="bottom: 12%; left: 14%; height: 28%;"></div>
            <div class="road road-v" style="bottom: 12%; left: 80%; height: 28%;"></div>

            <!-- ===== BRIDGE ===== -->
            <div class="bridge" style="bottom: calc(40% - 5px); left: calc(48% - 15px);">
                <div class="bridge-railing">
                    <div class="bridge-post"></div><div class="bridge-post"></div>
                    <div class="bridge-post"></div><div class="bridge-post"></div>
                    <div class="bridge-post"></div><div class="bridge-post"></div>
                    <div class="bridge-post"></div><div class="bridge-post"></div>
                </div>
                <div class="bridge-deck"></div>
            </div>

            <!-- ===== 3D FARM BUILDING ===== -->
            <div class="iso-bldg bldg-farm" style="bottom: 44%; left: 3%;">
                <div class="iso-top"></div>
                <div class="iso-front"></div>
                <div class="iso-right"></div>
                <span class="bldg-farm-label">🚜 NÔNG TRẠI VIETGAP</span>
            </div>

            <!-- Greenhouse -->
            <div class="greenhouse" style="bottom: 56%; left: 27%;">
                <div class="greenhouse-body"></div>
            </div>

            <!-- Crop rows -->
            <div class="crop-rows" style="bottom: 22%; left: 5%;">
                <div class="crop-row">
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                </div>
                <div class="crop-row">
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                </div>
                <div class="crop-row">
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                </div>
                <div class="crop-row">
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                    <div class="crop"></div><div class="crop"></div><div class="crop"></div>
                </div>
            </div>

            <!-- ===== 3D FACTORY BUILDING ===== -->
            <div class="iso-bldg bldg-factory" style="bottom: 44%; left: 30%;">
                <div class="iso-top"></div>
                <div class="iso-front"></div>
                <div class="iso-right"></div>
                <span class="bldg-factory-label">🏭 NHÀ MÁY CHẾ BIẾN HVS</span>
            </div>
            <div class="factory-logo" style="bottom: calc(44% + 100px); left: calc(30% + 230px);">HVS</div>

            <!-- Chimneys -->
            <div class="chimney" style="bottom: calc(44% + 235px); left: 34%;">
                <div class="chimney-smoke"></div>
                <div class="chimney-smoke"></div>
                <div class="chimney-smoke"></div>
                <div class="chimney-body"></div>
            </div>
            <div class="chimney" style="bottom: calc(44% + 235px); left: 38%;">
                <div class="chimney-smoke"></div>
                <div class="chimney-smoke"></div>
                <div class="chimney-body"></div>
            </div>

            <!-- ===== 3D SCHOOL / CANTEEN BUILDING ===== -->
            <div class="iso-bldg bldg-school" style="bottom: 44%; left: 60%;">
                <div class="iso-top"></div>
                <div class="iso-front"></div>
                <div class="iso-right"></div>
                <span class="bldg-school-label">🏫 BẾP ĂN TRƯỜNG HỌC</span>
            </div>

            <!-- ===== TREES (mixed styles) ===== -->
            <div class="tree" style="bottom: 58%; left: 1.5%;"><div class="tree-top"></div><div class="tree-trunk"></div></div>
            <div class="tree" style="bottom: 63%; left: 9%;"><div class="tree-top"></div><div class="tree-trunk"></div></div>
            <div class="tree" style="bottom: 50%; left: 26%;"><div class="tree-top-pine"></div><div class="tree-trunk"></div></div>
            <div class="tree" style="bottom: 18%; left: 22%;"><div class="tree-top"></div><div class="tree-trunk"></div></div>
            <div class="tree" style="bottom: 14%; left: 52%;"><div class="tree-top-pine"></div><div class="tree-trunk"></div></div>
            <div class="tree" style="bottom: 53%; left: 56%;"><div class="tree-top"></div><div class="tree-trunk"></div></div>
            <div class="tree" style="bottom: 60%; left: 87%;"><div class="tree-top"></div><div class="tree-trunk"></div></div>
            <div class="tree" style="bottom: 22%; left: 88%;"><div class="tree-top-pine"></div><div class="tree-trunk"></div></div>
            <div class="tree" style="bottom: 16%; left: 70%;"><div class="tree-top"></div><div class="tree-trunk"></div></div>
            <div class="tree" style="bottom: 32%; left: 94%;"><div class="tree-top-pine"></div><div class="tree-trunk"></div></div>
            <div class="tree" style="bottom: 65%; left: 45%;"><div class="tree-top"></div><div class="tree-trunk"></div></div>
            <div class="tree" style="bottom: 10%; left: 38%;"><div class="tree-top"></div><div class="tree-trunk"></div></div>

            <!-- ===== SIGNS ===== -->
            <div class="map-sign" style="bottom: 47%; left: 13%;">KHU VỰC NÔNG TRẠI</div>
            <div class="map-sign" style="bottom: 74%; left: 40%;">KHU CHẾ BIẾN THỰC PHẨM</div>
            <div class="map-sign" style="bottom: 47%; left: 72%;">KHU VỰC PHÂN PHỐI</div>

            <!-- ===== VEHICLES ===== -->
            <div class="vehicle vehicle-truck">HVS</div>
            <div class="vehicle vehicle-plane">✈️</div>

            <!-- ===== HOTSPOTS ===== -->
            <div class="hotspot" style="bottom: 58%; left: 15%;"
                 data-title="Nông Trại VietGAP"
                 data-desc="Vùng trồng rau sạch an toàn tuyệt đối theo tiêu chuẩn VietGAP. Tuân thủ nghiêm ngặt quy trình tưới tiêu, bón phân hữu cơ. Cung cấp nguồn nguyên liệu tươi sạch cho toàn bộ chuỗi chế biến.">
                <div class="hotspot-icon"><i class="fas fa-leaf"></i></div>
                <div class="hotspot-label">Nông Trại VietGAP</div>
            </div>

            <div class="hotspot" style="bottom: 58%; left: 43%;"
                 data-title="Nhà Máy Chế Biến HVS"
                 data-desc="Nhà máy sơ chế và sản xuất thực phẩm khép kín. Nơi cho ra đời các sản phẩm Giò Chả, Ruốc đạt chuẩn OCOP 4 sao và bún phở sạch. Quy trình sản xuất hiện đại, đảm bảo ATTP.">
                <div class="hotspot-icon"><i class="fas fa-industry"></i></div>
                <div class="hotspot-label">Nhà Máy Chế Biến</div>
            </div>

            <div class="hotspot" style="bottom: 58%; left: 73%;"
                 data-title="Bếp Ăn Công Nghiệp"
                 data-desc="Hệ thống cung cấp suất ăn quy mô lớn cho trường học, bệnh viện, doanh nghiệp. Đảm bảo vệ sinh an toàn thực phẩm tuyệt đối từ khâu nguyên liệu đến bàn ăn.">
                <div class="hotspot-icon"><i class="fas fa-utensils"></i></div>
                <div class="hotspot-label">Bếp Ăn Công Nghiệp</div>
            </div>

        </div>
    </div>
</section>

<!-- MODAL OVERLAY -->
<div class="map-modal" id="ecosystemModal">
    <div class="modal-content">
        <div class="modal-header">
            <h3 id="modal-title">Tiêu đề</h3>
            <button class="modal-close">&times;</button>
        </div>
        <div class="modal-body"></div>
    </div>
</div>

@section Scripts {
    <script src="~/js/ecosystem-map.js" asp-append-version="true"></script>
}
