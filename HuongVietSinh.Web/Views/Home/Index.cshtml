@{
    ViewData["Title"] = "Trang chủ";
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<!-- HERO - Slider -->
<section class="home-hero">
    <div class="hero-slider">
        <div class="hero-slide active">
            <img class="hero-bg-img" src="/image/hero-1.png" alt="Tận tâm nâng cao chất lượng cuộc sống Việt">
            <div class="hero-overlay">
                <div class="hero-inner container">
                    <p class="hero-caption">Tận tâm nâng cao chất lượng cuộc sống Việt</p>
                    <p class="hero-desc">Chúng tôi kiến tạo hệ sinh thái thực phẩm khép kín để mang đến giải pháp dinh dưỡng an toàn, bền vững cho thế hệ tương lai.</p>
                    <div class="hero-cta">
                        <a asp-controller="Home" asp-action="About" class="btn-hero btn-hero-primary">Xem hồ sơ năng lực</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="hero-slide">
            <img class="hero-bg-img" src="/image/hero-2.png" alt="4 vùng trồng rau an toàn">
            <div class="hero-overlay">
                <div class="hero-inner container">
                    <p class="hero-caption">4 vùng trồng rau an toàn với diện tích gần 45 ha</p>
                    <p class="hero-desc">Chúng tôi kiến tạo hệ sinh thái thực phẩm khép kín để mang đến giải pháp dinh dưỡng an toàn, bền vững cho thế hệ tương lai.</p>
                    <div class="hero-cta">
                        <a asp-controller="Home" asp-action="About" class="btn-hero btn-hero-primary">Xem hồ sơ năng lực</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="hero-slide">
            <img class="hero-bg-img" src="/image/hero-3.png" alt="Xưởng chế biến thực phẩm">
            <div class="hero-overlay">
                <div class="hero-inner container">
                    <p class="hero-caption">Xưởng chế biến thực phẩm (giò, chả, xúc xích) an toàn, không hàn the</p>
                    <p class="hero-desc">Chúng tôi kiến tạo hệ sinh thái thực phẩm khép kín để mang đến giải pháp dinh dưỡng an toàn, bền vững cho thế hệ tương lai.</p>
                    <div class="hero-cta">
                        <a asp-controller="Home" asp-action="About" class="btn-hero btn-hero-primary">Xem hồ sơ năng lực</a>
                    </div>
                </div>
            </div>
        </div>
        <div class="hero-slide">
            <img class="hero-bg-img" src="/image/hero-4.png" alt="Xưởng sản xuất đậu phụ, bún, bánh phở">
            <div class="hero-overlay">
                <div class="hero-inner container">
                    <p class="hero-caption">Xưởng sản xuất đậu phụ, giá đỗ, bún, bánh phở tươi</p>
                    <p class="hero-desc">Chúng tôi kiến tạo hệ sinh thái thực phẩm khép kín để mang đến giải pháp dinh dưỡng an toàn, bền vững cho thế hệ tương lai.</p>
                    <div class="hero-cta">
                        <a asp-controller="Home" asp-action="About" class="btn-hero btn-hero-primary">Xem hồ sơ năng lực</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="hero-nav">
        <button type="button" class="hero-nav-dot active" data-i="0"></button>
        <button type="button" class="hero-nav-dot" data-i="1"></button>
        <button type="button" class="hero-nav-dot" data-i="2"></button>
        <button type="button" class="hero-nav-dot" data-i="3"></button>
    </div>
</section>


<!-- PARTNERS CAROUSEL -->
<section class="home-partners reveal">
    <div class="container">
        <h2 class="section-title">Đối tác đồng hành</h2>
        <p class="section-subtitle">Đồng hành cùng các cơ quan, đơn vị và trường học tại Hà Nội và Bắc Ninh</p>
    </div>
    <div class="partners-track">
        <div class="partners-slide">
            <!-- Bộ 1 - 8 đối tác -->
            <img class="partner-logo" src="/image/homepage/partner-1.png" alt="Trường Tiểu học Trung Nhị">
            <img class="partner-logo" src="/image/homepage/partner-2.jpg" alt="THCS Thanh Quan">
            <img class="partner-logo" src="/image/homepage/partner-3.png" alt="Trường Tiểu học Nguyễn Tri Phương">
            <img class="partner-logo" src="/image/homepage/partner-4.png" alt="Trường Tiểu học Quảng An">
            <img class="partner-logo" src="/image/homepage/partner-5.jpg" alt="THCS Trần Duy Hưng">
            <img class="partner-logo" src="/image/homepage/partner-6.jpg" alt="Báo Lao Động">
            <img class="partner-logo" src="/image/homepage/partner-7.jpg" alt="Trường Tiểu học Chu Văn An A">
            <img class="partner-logo" src="/image/homepage/partner-8.jpg" alt="THCS Ngô Sĩ Liên">
            <!-- Bộ 2 - nhân đôi cho infinite scroll -->
            <img class="partner-logo" src="/image/homepage/partner-1.png" alt="Trường Tiểu học Trung Nhị">
            <img class="partner-logo" src="/image/homepage/partner-2.jpg" alt="THCS Thanh Quan">
            <img class="partner-logo" src="/image/homepage/partner-3.png" alt="Trường Tiểu học Nguyễn Tri Phương">
            <img class="partner-logo" src="/image/homepage/partner-4.png" alt="Trường Tiểu học Quảng An">
            <img class="partner-logo" src="/image/homepage/partner-5.jpg" alt="THCS Trần Duy Hưng">
            <img class="partner-logo" src="/image/homepage/partner-6.jpg" alt="Báo Lao Động">
            <img class="partner-logo" src="/image/homepage/partner-7.jpg" alt="Trường Tiểu học Chu Văn An A">
            <img class="partner-logo" src="/image/homepage/partner-8.jpg" alt="THCS Ngô Sĩ Liên">
        </div>
    </div>
</section>

<!-- ECOSYSTEM -->
<section class="home-ecosystem">
    <div class="container">
        <h2 class="section-title reveal">Hệ sinh thái "Từ trang trại tới bàn ăn"</h2>

        <div class="eco-map" id="ecoMap">
            <!-- SVG connection lines -->
            <svg class="eco-lines" viewBox="0 0 800 500" preserveAspectRatio="xMidYMid meet">
                <!-- Line: Vùng trồng rau → Trường học -->
                <path class="eco-line eco-line-1" d="M400,130 C400,180 400,200 400,220" />
                <circle class="eco-particle eco-particle-1" r="5">
                    <animateMotion dur="2s" repeatCount="indefinite" path="M400,130 C400,180 400,200 400,220" />
                </circle>

                <!-- Line: Xưởng đồ tươi → Trường học -->
                <path class="eco-line eco-line-2" d="M180,370 C250,340 330,290 370,260" />
                <circle class="eco-particle eco-particle-2" r="5">
                    <animateMotion dur="2s" repeatCount="indefinite" begin="0.5s" path="M180,370 C250,340 330,290 370,260" />
                </circle>

                <!-- Line: Xưởng chế biến → Trường học -->
                <path class="eco-line eco-line-3" d="M620,370 C550,340 470,290 430,260" />
                <circle class="eco-particle eco-particle-3" r="5">
                    <animateMotion dur="2s" repeatCount="indefinite" begin="1s" path="M620,370 C550,340 470,290 430,260" />
                </circle>
            </svg>

            <!-- Pulse ring -->
            <div class="eco-pulse eco-pulse-center"></div>

            <!-- Center: Trường học -->
            <div class="eco-center">
                <span class="eco-center-icon"><i class="fas fa-school"></i></span>
                <span class="eco-center-label">Trường học<br>khang trang</span>
            </div>

            <!-- Satellite 1: Vùng trồng rau  -->
            <div class="eco-satellite eco-sat-1">
                <span class="eco-sat-icon"><i class="fas fa-seedling"></i></span>
                <span class="eco-sat-label">Vùng trồng rau an toàn</span>
                <span class="eco-sat-sub">Việt Hưng</span>
            </div>

            <!-- Satellite 2: Xưởng đồ tươi -->
            <div class="eco-satellite eco-sat-2">
                <span class="eco-sat-icon"><i class="fas fa-industry"></i></span>
                <span class="eco-sat-label">Xưởng sản xuất đồ tươi</span>
                <span class="eco-sat-sub">Bắc Ninh</span>
            </div>

            <!-- Satellite 3: Xưởng chế biến -->
            <div class="eco-satellite eco-sat-3">
                <span class="eco-sat-icon"><i class="fas fa-drumstick-bite"></i></span>
                <span class="eco-sat-label">Xưởng chế biến thực phẩm</span>
                <span class="eco-sat-sub">Giò, chả, xúc xích</span>
            </div>
        </div>
    </div>
</section>

<!-- CORE VALUES -->
<section class="home-values">
    <div class="container">
        <h2 class="section-title reveal">Giá trị cốt lõi</h2>
        <p class="section-subtitle reveal">Năm chữ vàng dẫn lối mọi hoạt động</p>

        <div class="values-grid reveal-children" id="valuesGrid">
            <div class="value-item">
                <div class="value-circle">
                    <span class="value-char calligraphy">Nhân</span>
                </div>
                <p class="value-name">Nhân</p>
                <div class="value-tooltip">
                    <p class="value-tooltip-title">Nhân</p>
                    <p>Xây dựng các mối quan hệ với khách hàng, đối tác, cộng đồng xã hội, người lao động trong công ty bằng sự chân thành, tinh thần nhân văn và sự thiện chí.</p>
                </div>
            </div>

            <div class="value-item">
                <div class="value-circle">
                    <span class="value-char calligraphy">Nghĩa</span>
                </div>
                <p class="value-name">Nghĩa</p>
                <div class="value-tooltip">
                    <p class="value-tooltip-title">Nghĩa</p>
                    <p>Trách nhiệm với nhân viên, cộng đồng và xã hội.</p>
                </div>
            </div>

            <div class="value-item">
                <div class="value-circle">
                    <span class="value-char calligraphy">Trí</span>
                </div>
                <p class="value-name">Trí</p>
                <div class="value-tooltip">
                    <p class="value-tooltip-title">Trí</p>
                    <p>Coi sự sáng tạo là một tài sản vô giá của mình, do vậy chúng tôi luôn sáng tạo và cải tiến không ngừng trong quy trình.</p>
                </div>
            </div>

            <div class="value-item">
                <div class="value-circle">
                    <span class="value-char calligraphy">Tín</span>
                </div>
                <p class="value-name">Tín</p>
                <div class="value-tooltip">
                    <p class="value-tooltip-title">Tín</p>
                    <p>Giữ trọn lời cam kết về chất lượng và an toàn.</p>
                </div>
            </div>

            <div class="value-item">
                <div class="value-circle">
                    <span class="value-char calligraphy">Tâm</span>
                </div>
                <p class="value-name">Tâm</p>
                <div class="value-tooltip">
                    <p class="value-tooltip-title">Tâm</p>
                    <p>Làm việc bằng tất cả sự tận tụy và nhiệt huyết. Chúng tôi cam kết luôn nỗ lực để mang đến cho khách hàng những sản phẩm chất lượng nhất, an toàn nhất – dịch vụ hoàn hảo nhất.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- 3 DỊCH VỤ MŨI NHỌN -->
<section class="home-services">
    <div class="container">
        <h2 class="section-title reveal">Ba dịch vụ mũi nhọn</h2>

        <!-- Dịch vụ 1 -->
        <div class="service-block reveal">
            <div class="service-img-wrap">
                <img class="service-img" src="~/image/hvs-chia-suat-an.jpg" alt="Cung cấp suất ăn học đường - Chia suất ăn đảm bảo an toàn">
            </div>
            <div class="service-content">
                <span class="service-tag">Dịch vụ 01</span>
                <h3 class="service-name">Cung cấp suất ăn</h3>
                <p class="service-desc">Chăm chút từng khay cơm bằng sự tận tâm. Mỗi suất ăn là kết tinh của quy trình khép kín từ nguồn nguyên liệu an toàn, chế biến đạt chuẩn vệ sinh, đến vận chuyển chuyên nghiệp.</p>
            </div>
        </div>

        <!-- Dịch vụ 2 -->
        <div class="service-block reverse reveal">
            <div class="service-img-wrap">
                <img class="service-img" src="~/image/hvs-doi-ngu-nhan-vien.jpg" alt="Tổ chức sự kiện liên hoan và canteen - Đội ngũ nhân viên chuyên nghiệp">
            </div>
            <div class="service-content">
                <span class="service-tag">Dịch vụ 02</span>
                <h3 class="service-name">Tổ chức sự kiện liên hoan và canteen</h3>
                <p class="service-desc">Dịch vụ chuyên nghiệp, tạo nên những khoảnh khắc gắn kết trọn vẹn. Từ tiệc liên hoan đến vận hành canteen trường học, chúng tôi mang đến trải nghiệm ẩm thực đáng nhớ.</p>
            </div>
        </div>

        <!-- Dịch vụ 3 -->
        <div class="service-block reveal">
            <div class="service-img-wrap">
                <img class="service-img" src="~/image/hvs-nguyen-lieu-tuoi.jpg" alt="Cung ứng thực phẩm an toàn - Nguyên liệu tươi sạch">
            </div>
            <div class="service-content">
                <span class="service-tag">Dịch vụ 03</span>
                <h3 class="service-name">Cung ứng thực phẩm an toàn</h3>
                <p class="service-desc">Nguồn nguyên liệu đa dạng từ hệ sinh thái tự chủ, đạt chuẩn VietGAP và OCOP. Từ rau củ tươi, đậu phụ, bún phở đến giò chả — tất cả được sản xuất trong quy trình kiểm soát nghiêm ngặt.</p>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/home.js" asp-append-version="true"></script>
}
