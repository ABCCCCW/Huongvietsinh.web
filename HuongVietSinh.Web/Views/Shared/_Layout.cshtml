<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Hương Việt Sinh</title>
    <link rel="stylesheet" href="~/css/common.css">
    @await RenderSectionAsync("Styles", required: false)
    <link rel="icon" type="image/png" href="~/image/favicon.png">
</head>
<body>

    <header class="main-header">
        <div class="container">
            <a asp-controller="Home" asp-action="Index" class="brand-logo">
                <img src="~/image/logo.png" alt="Hương Việt Sinh" style="max-height:50px;margin-right:10px;">
                <span style="font-weight:700;font-size:20px;color:#e21e26;">HƯƠNG VIỆT SINH</span>
            </a>
            <button class="mobile-toggle"><i class="fas fa-bars"></i></button>
            <nav class="nav-menu">
                <a asp-controller="Home" asp-action="About" class="nav-link">Về chúng tôi</a>
                <a asp-controller="Services" asp-action="Ecosystem" class="nav-link">Hệ sinh thái</a>
                <a asp-controller="Services" asp-action="Index" class="nav-link">Dịch vụ</a>
                <a asp-controller="News" asp-action="Index" class="nav-link">Tin tức</a>
                <a asp-controller="Contact" asp-action="Index" class="nav-link">Liên hệ</a>
            </nav>
        </div>
    </header>

    @RenderBody()

    <footer class="main-footer">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-col footer-info">
                    <h4>CÔNG TY TNHH HƯƠNG VIỆT SINH</h4>
                    <p>Địa chỉ: Lô BT1, ngõ 191, Phúc Lợi, Long Biên, Hà Nội</p>
                    <p>Hỗ trợ: 0963 826 668</p>
                    <p>Email: info@huongvietsinh.com.vn</p>
                </div>
                <div class="footer-col footer-links">
                    <h4>TẦM NHÌN DÀI HẠN</h4>
                    <p><a asp-controller="Home" asp-action="Index">Dự án mở rộng vùng trồng</a></p>
                    <p><a asp-controller="Home" asp-action="Index">Dự án Chuyển đổi số</a></p>
                    <p><a asp-controller="Home" asp-action="Index">Năng lực công ty</a></p>
                </div>
                <div class="footer-col footer-links">
                    <h4>GIẢI ĐÁP</h4>
                    <p><a asp-controller="Services" asp-action="Products">Nguồn gốc và An toàn thực phẩm</a></p>
                    <p><a asp-controller="Services" asp-action="Catering">Chất lượng bữa ăn</a></p>
                </div>
                <div class="footer-col footer-links">
                    <h4>HỖ TRỢ TẬN TÂM</h4>
                    <p><a asp-controller="Recruitment" asp-action="Index">Tuyển dụng</a></p>
                    <p><a asp-controller="Contact" asp-action="Index">Liên hệ</a></p>
                </div>
            </div>
            <div class="footer-bottom">
                <p>&copy; 2026 Huong Viet Sinh Co., Ltd. All rights reserved.</p>
            </div>
        </div>
    </footer>

    <script src="~/js/common.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
